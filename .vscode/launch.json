{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev & Debug Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "preLaunchTask": "npm: dev"
    },
    {
      "name": "Launch Chrome (Debug)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "port": 9222,
      "userDataDir": "${workspaceFolder}/.chrome-debug-profile"
    },
    {
      "name": "Attach to Chrome (Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "url": "http://localhost:5173"
    }
  ]
}
